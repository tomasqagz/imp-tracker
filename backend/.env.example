# ─────────────────────────────────────────────
# Credenciales por servicio
# Copiá este archivo como .env y completá con tus datos
# ─────────────────────────────────────────────

# Naturgy (gas) — plataforma Widergy, Utility-ID: 8
NATURGY_EMAIL=tu_email@ejemplo.com
NATURGY_PASSWORD=tu_contraseña

# Edenor (electricidad) — plataforma Widergy, Utility-ID: 19
EDENOR_EMAIL=tu_email@ejemplo.com
EDENOR_PASSWORD=tu_contraseña

# Aysa (agua) — portal SAP con login via browser
AYSA_EMAIL=tu_email@ejemplo.com
AYSA_PASSWORD=tu_contraseña

# ─────────────────────────────────────────────
# Para agregar un nuevo servicio Widergy:
#   1. Agregá las variables acá con el prefijo del servicio
#   2. Anotá el Utility-ID desde DevTools (header Utility-ID)
#   3. Agregá una entrada en backend/config.py
# ─────────────────────────────────────────────
# NUEVO_SERVICIO_EMAIL=tu_email@ejemplo.com
# NUEVO_SERVICIO_PASSWORD=tu_contraseña
